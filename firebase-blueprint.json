{
  "entities": {
    "users": {
      "title": "User",
      "description": "Telegram user with balance and referral metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "referrals": { "type": "number" },
        "firstName": { "type": "string" },
        "referredBy": { "type": "string" },
        "firstSeen": { "type": "string", "format": "date-time" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance", "referrals"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User referral and balance document"
    }
  }
}
